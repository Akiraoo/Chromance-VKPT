#version 460
#extension GL_GOOGLE_include_directive : require

// Eye adaptation. Runs after the world is traced: measures the brightness of the frame (centre weighted, log
// average), removes the exposure it was rendered with, and moves the exposure towards a target over time.
//   dark -> bright (exposure falls): fast, so stepping out of a cave first dazzles, then settles within a second;
//   bright -> dark (exposure rises): slow, several seconds to see in the dark, and only up to a limit, so a pitch
//   black cave never turns bright.
// The state lives in a 1x1 texture: x = exposure multiplier, y = game time of the last update, z = initialised.

#include "common/shared.hpp"
#include "lib/settings.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 2, binding = 0) uniform WorldUniform {
    WorldUBO worldUBO;
};

layout(set = 3, binding = 0, rgba16f) uniform readonly image2D outputImage;
layout(set = 5, binding = 11, rgba32f) uniform image2D eyeExposureState;

shared float sharedLog[64];
shared float sharedWeight[64];

void main() {
    uint id = gl_LocalInvocationID.x;
    ivec2 size = imageSize(outputImage);
    float logSum = 0.0;
    float weightSum = 0.0;
    // 32 x 18 grid, 9 samples per thread.
    for (uint i = id; i < 576u; i += 64u) {
        vec2 cell = (vec2(float(i % 32u), float(i / 32u)) + 0.5) / vec2(32.0, 18.0);
        ivec2 p = clamp(ivec2(cell * vec2(size)), ivec2(0), size - ivec2(1));
        vec3 c = imageLoad(outputImage, p).rgb;
        float lum = dot(max(c, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
        if (!(lum >= 0.0) || isinf(lum)) { lum = 0.0; }
        vec2 d = (cell - 0.5) * vec2(1.6, 1.0);
        float w = exp(-dot(d, d) * 4.0);   // centre weighted
        logSum += log2(max(lum, 1e-5)) * w;
        weightSum += w;
    }
    sharedLog[id] = logSum;
    sharedWeight[id] = weightSum;
    barrier();
    if (id != 0u) { return; }
    for (uint i = 1u; i < 64u; ++i) {
        logSum += sharedLog[i];
        weightSum += sharedWeight[i];
    }

    vec4 state = imageLoad(eyeExposureState, ivec2(0));
    bool initialised = state.z > 0.5 && state.x > 0.0 && !isinf(state.x);
    float current = initialised ? state.x : 1.0;
    // Brightness of the scene itself (the frame was rendered with the current exposure).
    float sceneEv = logSum / max(weightSum, 1e-4) - log2(current);

    // Target: partially undo the scene brightness around a mid level, within limits.
    const float keyEv = -1.5;   // the brightness a daylight scene sits at without adaptation
    float strength = clamp(float(CHR_EYE_ADAPTATION_STRENGTH), 0.0, 1.0);
    float targetEv = clamp((keyEv - sceneEv) * strength, -2.0, float(CHR_EYE_ADAPTATION_MAX_EV));

    float now = worldUBO.gameTime * 1200.0;
    float dt = initialised ? now - state.y : 0.0;
    if (dt < 0.0) { dt += 1200.0; }
    dt = clamp(dt, 0.0, 0.25);

    float currentEv = log2(current);
    float speed = max(float(CHR_EYE_ADAPTATION_SPEED), 0.05);
    float rate = targetEv > currentEv ? 0.35 * speed : 2.2 * speed;   // per second
    float newEv = initialised ? mix(currentEv, targetEv, 1.0 - exp(-dt * rate)) : targetEv;

    imageStore(eyeExposureState, ivec2(0), vec4(exp2(newEv), now, 1.0, 0.0));
}
