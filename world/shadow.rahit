#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Shadow rays: opaque geometry blocks the light, translucent surfaces tint it, water lets it through with a
// little absorption, cut-out pixels are skipped.

#include "lib/resources_rt.glsl"
#include "lib/payload.glsl"
#include "interface/color_space.glsl"
#include "interface/vista.glsl"
#include "lib/water.glsl"
#include "lib/waves.glsl"

layout(location = 1) rayPayloadInEXT ChrShadowRay shadowRay;
hitAttributeEXT vec2 attribs;

void main() {
    if (isVistaCovered(worldUBO, gl_InstanceCustomIndexEXT, attribs)) {
        ignoreIntersectionEXT;
        return;
    }
    uint geometryBufferIndex = getGeometryBufferIndex(gl_InstanceCustomIndexEXT, gl_GeometryIndexEXT);
    uint i0, i1, i2;
    MaterialVertex m0, m1, m2;
    loadTriangleIndices(geometryBufferIndex, gl_PrimitiveID, i0, i1, i2);
    loadTriangleMaterial(geometryBufferIndex, i0, i1, i2, m0, m1, m2);

    vec3 bary = vec3(1.0 - attribs.x - attribs.y, attribs.x, attribs.y);
    uint packedData = m0.packedData;
    uint alphaMode = getAlphaMode(packedData);
    vec4 colorLayer = hasColorLayer(packedData) ? bary.x * m0.colorLayer + bary.y * m1.colorLayer + bary.z * m2.colorLayer : vec4(1.0);

    vec4 albedo = vec4(1.0);
    bool isWater = hasWaterMaterial(m0);
    if (hasTexture(packedData)) {
        vec2 uv = bary.x * m0.textureUV + bary.y * m1.textureUV + bary.z * m2.textureUV;
        albedo = resolveSurfaceTextureColor(sampleTexture(textures[nonuniformEXT(m0.textureID)], uv, 0.0, false), alphaMode);
        int flagTexture = mapping.entries[m0.textureID].flag;
        if (flagTexture >= 0) {
            ivec4 flags = ivec4(round(sampleTexture(textures[nonuniformEXT(flagTexture)], uv, 0.0, false) * 255.0));
            isWater = isWater || (flags.r & 0x1) > 0;
        }
    }
    vec4 shaded = albedo * colorLayer;
    float alpha = resolveSurfaceAlpha(shaded.a, alphaMode);
    if (alpha < 0.05) {
        ignoreIntersectionEXT;
        return;
    }

    bool insideBoat = (shadowRay.visible & 2u) != 0u;
    if (isWater && (shadowRay.visible & 4u) != 0u) {
        // Probe for the water surface (world.rgen): report its distance and biome colour, then stop.
        shadowRay.throughput = vec3(gl_HitTEXT);
        shadowRay.visible = (shadowRay.visible & 0xffu) | (chrPackWaterTint(colorLayer.rgb) << 8u);
        terminateRayEXT;
        return;
    }
    if (isWater) {
        if (!insideBoat) {
            // The ray started under water and leaves through this surface: absorb along the water it crossed,
            // plus a touch of Fresnel loss at the surface.
            float travelled = gl_WorldRayDirectionEXT.y > 0.0 ? gl_HitTEXT : 0.0;
            shadowRay.throughput *= exp(-chrWaterAbsorptionTinted(shadowRay.visible >> 8u) * travelled) * 0.92;
#if CHR_WATER_WAVE_OVERLAY
            // Caustics: the wavy surface (the same waves the overlay draws) focuses the light it lets through.
            if (gl_WorldRayDirectionEXT.y > 0.0 && travelled > 0.0) {
                vec3 crossing = gl_WorldRayOriginEXT + gl_WorldRayDirectionEXT * gl_HitTEXT + vec3(worldUBO.cameraPos.xyz);
                float depthBelow = travelled * gl_WorldRayDirectionEXT.y;
                float c = chrCausticFast(crossing.xz, worldUBO.gameTime * 1200.0, depthBelow, 0.0);
                float amount = clamp(float(CHR_WATER_WAVE_OVERLAY_STRENGTH), 0.0, 2.0) * 0.5;
                shadowRay.throughput *= max(mix(1.0, c, amount), 0.0);
            }
#endif
        }
        ignoreIntersectionEXT;
        return;
    }

    if (!isAlphaBlendedMode(alphaMode) || alpha >= 0.999) {
        shadowRay.throughput = vec3(0.0);
        terminateRayEXT;
        return;
    }

    // Stained glass and other translucent surfaces: coloured shadow.
    vec3 transmission = clamp(mix(vec3(1.0), shaded.rgb, alpha), vec3(0.0), vec3(1.0)) * (1.0 - alpha * 0.5);
    shadowRay.throughput *= transmission;
    if (max(shadowRay.throughput.r, max(shadowRay.throughput.g, shadowRay.throughput.b)) < 1e-3) {
        shadowRay.throughput = vec3(0.0);
        terminateRayEXT;
        return;
    }
    ignoreIntersectionEXT;
}
