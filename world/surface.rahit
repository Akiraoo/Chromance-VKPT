#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Alpha test for main rays: cut-out pixels, water seen from inside a boat, and the water surface a refraction
// ray just left.

#include "lib/resources_rt.glsl"
#include "lib/payload.glsl"
#include "interface/ray_cone.glsl"
#include "interface/color_space.glsl"
#include "interface/vista.glsl"

layout(location = 0) rayPayloadInEXT ChrRay ray;
hitAttributeEXT vec2 attribs;

void main() {
    if (chrHasBit(ray, CHR_EYE_PROBE_BIT)) {
        // Probe for mob eye layers (world/surface_impl.glsl): everything else is invisible to it.
        ignoreIntersectionEXT;
        return;
    }
    if (isVistaCovered(worldUBO, gl_InstanceCustomIndexEXT, attribs)) {
        ignoreIntersectionEXT;
        return;
    }
    uint geometryBufferIndex = getGeometryBufferIndex(gl_InstanceCustomIndexEXT, gl_GeometryIndexEXT);
    uint i0, i1, i2;
    MaterialVertex m0, m1, m2;
    loadTriangleIndices(geometryBufferIndex, gl_PrimitiveID, i0, i1, i2);
    loadTriangleMaterial(geometryBufferIndex, i0, i1, i2, m0, m1, m2);

    vec3 bary = vec3(1.0 - attribs.x - attribs.y, attribs.x, attribs.y);
    uint packedData = m0.packedData;
    uint alphaMode = getAlphaMode(packedData);
    float alpha = hasColorLayer(packedData) ? (bary.x * m0.colorLayer + bary.y * m1.colorLayer + bary.z * m2.colorLayer).a : 1.0;

    vec2 uv = vec2(0.0);
    float lod = 0.0;
    if (hasTexture(packedData)) {
        uv = bary.x * m0.textureUV + bary.y * m1.textureUV + bary.z * m2.textureUV;
        PositionVertex p0, p1, p2;
        loadTrianglePositions(geometryBufferIndex, i0, i1, i2, p0, p1, p2);
        vec3 dposdu, dposdv;
        computedposduDv(p0.pos, p1.pos, p2.pos, m0.textureUV, m1.textureUV, m2.textureUV, dposdu, dposdv);
        lod = lodWithCone(textures[nonuniformEXT(m0.textureID)], uv, ray.coneWidth + gl_HitTEXT * ray.coneSpread, dposdu, dposdv);
        alpha *= resolveSurfaceTextureColor(sampleTexture(textures[nonuniformEXT(m0.textureID)], uv, lod, false), alphaMode).a;
    }
    alpha = resolveSurfaceAlpha(alpha, alphaMode);
    if (alpha < 0.05) {
        ignoreIntersectionEXT;
        return;
    }

    bool ignoreWater = chrHasBit(ray, CHR_IGNORE_WATER_SELF_BIT) || chrHasBit(ray, CHR_INSIDE_BOAT_BIT);
    if (!ignoreWater) { return; }
    bool isWater = hasWaterMaterial(m0);
    if (!isWater && hasTexture(packedData)) {
        int flagTexture = mapping.entries[m0.textureID].flag;
        if (flagTexture >= 0) {
            ivec4 flags = ivec4(round(sampleTexture(textures[nonuniformEXT(flagTexture)], uv, ceil(lod), false) * 255.0));
            isWater = (flags.r & 0x1) > 0;
        }
    }
    if (isWater) { ignoreIntersectionEXT; }
}
