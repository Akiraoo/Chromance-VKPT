#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Alpha test for text drawn in the world (signs, name tags seen by rays).

#include "lib/resources_rt.glsl"
#include "lib/payload.glsl"
#include "interface/ray_cone.glsl"
#include "interface/color_space.glsl"

layout(location = 0) rayPayloadInEXT ChrRay ray;
hitAttributeEXT vec2 attribs;

void main() {
    uint geometryBufferIndex = getGeometryBufferIndex(gl_InstanceCustomIndexEXT, gl_GeometryIndexEXT);
    uint i0, i1, i2;
    MaterialVertex m0, m1, m2;
    loadTriangleIndices(geometryBufferIndex, gl_PrimitiveID, i0, i1, i2);
    loadTriangleMaterial(geometryBufferIndex, i0, i1, i2, m0, m1, m2);
    vec3 bary = vec3(1.0 - attribs.x - attribs.y, attribs.x, attribs.y);
    uint packedData = m0.packedData;
    bool useTexture = hasTexture(packedData);
    uint textMode = getPostTextMode(packedData);
    float colorLayerAlpha = hasColorLayer(packedData) ? (bary.x * m0.colorLayer + bary.y * m1.colorLayer + bary.z * m2.colorLayer).a : 1.0;
    vec4 textureColor = vec4(1.0);
    if (useTexture) {
        vec2 uv = bary.x * m0.textureUV + bary.y * m1.textureUV + bary.z * m2.textureUV;
        PositionVertex p0, p1, p2;
        loadTrianglePositions(geometryBufferIndex, i0, i1, i2, p0, p1, p2);
        vec3 dposdu, dposdv;
        computedposduDv(p0.pos, p1.pos, p2.pos, m0.textureUV, m1.textureUV, m2.textureUV, dposdu, dposdv);
        float lod = lodWithCone(textures[nonuniformEXT(m0.textureID)], uv, ray.coneWidth + gl_HitTEXT * ray.coneSpread, dposdu, dposdv);
        textureColor = sampleTexture(textures[nonuniformEXT(m0.textureID)], uv, lod, false);
    }
    float alpha = resolveTextCoverage(textureColor, useTexture, colorLayerAlpha, textMode);
    if (alpha < 0.05) { ignoreIntersectionEXT; }
}
