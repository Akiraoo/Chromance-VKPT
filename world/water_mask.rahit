#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require

// The invisible surface that marks the inside of a boat. Once a ray is inside, it is ignored.
#include "lib/payload.glsl"

layout(location = 0) rayPayloadInEXT ChrRay ray;
hitAttributeEXT vec2 attribs;

void main() {
    if (chrHasBit(ray, CHR_EYE_PROBE_BIT)) {
        // Probe for mob eye layers (world/surface_impl.glsl): everything else is invisible to it.
        ignoreIntersectionEXT;
        return;
    }
    if (chrHasBit(ray, CHR_INSIDE_BOAT_BIT)) { ignoreIntersectionEXT; }
}
